{
  "name": "@usenotra/geo",
  "version": "0.9.0",
  "private": false,
  "description": "Request capture SDK for AI traffic attribution and agent feedback collection",
  "keywords": [
    "agents",
    "ai",
    "analytics",
    "astro",
    "attribution",
    "crawler",
    "edge",
    "feedback",
    "geo",
    "llms.txt",
    "mcp",
    "netlify",
    "nextjs",
    "nuxt",
    "react",
    "react-router",
    "sveltekit",
    "tanstack",
    "web-analytics"
  ],
  "homepage": "https://github.com/usenotra/geo-sdk#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/geo-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./netlify": {
      "types": "./dist/netlify.d.ts",
      "default": "./dist/netlify.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "default": "./dist/tanstack.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "default": "./dist/sveltekit.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "default": "./dist/react-router.js"
    },
    "./signatures": {
      "types": "./dist/signatures.d.ts",
      "default": "./dist/signatures.js"
    },
    "./classify": {
      "types": "./dist/classify.d.ts",
      "default": "./dist/classify.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "default": "./dist/html.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "default": "./dist/script.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test tests",
    "check-types": "tsc --noEmit --incremental --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "sync-script": "bun scripts/sync-notra-script.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@tanstack/react-start": "1.168.60",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/usenotra/geo-sdk/issues"
  },
  "packageManager": "bun@1.4.0"
}
